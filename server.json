{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.reshare/reshare",
  "title": "ReShare AI",
  "description": "Post your videos to your socials now or on a schedule, read analytics, and swap AI characters in.",
  "version": "1.1.0",
  "websiteUrl": "https://www.reshare.ai/docs/agents",
  "icons": [
    {
      "src": "https://www.reshare.ai/brand/logo/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://www.reshare.ai/brand/logo/app-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.reshare.ai/api/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://www.reshare.ai/api/mcp/public",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your ReShare AI API key rsk_…> (create one at https://www.reshare.ai/settings/agents). Needed for every tool call; listing tools, prompts and resources works without it.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/reshareai/agents",
    "source": "github"
  }
}
